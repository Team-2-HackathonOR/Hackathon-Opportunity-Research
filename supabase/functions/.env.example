GATEWAY_INTERNAL_SECRET=replace-with-the-main-gateway-server-secret
AUTH_GATEWAY_URL=https://gateway.example.com
EDGE_DATABASE_URL=postgresql://ROLE:PASSWORD@POOLER:6543/postgres
# Optional PEM CA from your Supabase project's Database settings; never disable TLS verification.
EDGE_DATABASE_CA=
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided automatically in hosted Edge Functions.
# Supply them privately for local runs; never put the service-role key in the browser.
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
STAGING_STORAGE_BUCKET=hackscout-staging
STAGING_STORAGE_PREFIX=hackscout/raw
PIPELINE_KEY_ENCRYPTION_KEY=replace-with-base64-random-32-byte-key
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini
# Optional, required only for automatic schedules:
AI_API_KEY=
