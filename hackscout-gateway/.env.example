# HackScout standalone gateway (run from hackscout-gateway/)
PORT=3002
# Optional legacy direct-backend Supabase routes only. Normal listings,
# submissions and moderation use the Hackathon Service DATABASE_URL.
SUPABASE_GRAPHQL_URL=https://knvqlbotviyrbljauvfz.supabase.co/graphql/v1
# Server-side Supabase secret/service-role key; never expose or commit this value.
SUPABASE_API_KEY=replace-with-your-supabase-secret-key
# Existing authenticated gateway; it verifies JWT sessions and admin roles.
# On Vercel, set this to the deployed MAIN gateway, not this HackScout app.
# Browser /api/hackscout/* and /api/auth/* requests are forwarded there.
AUTH_GATEWAY_URL=http://127.0.0.1:4000
# Must match the main gateway. Pipeline calls also go through that gateway.
GATEWAY_INTERNAL_SECRET=local-dev-gateway-secret
# Required only for automatic pipeline runs. Manual form keys are never saved.
AI_API_KEY=
# Optional persistent schedule location (default: .data/pipeline-schedule.json).
# PIPELINE_SCHEDULE_PATH=C:\path\to\pipeline-schedule.json
