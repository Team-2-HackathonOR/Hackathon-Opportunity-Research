PORT=4000
NODE_ENV=development
SERVICE_NAME=team-2-gateway
LOG_LEVEL=info

# Replace these with deployed backend base URLs when needed (not the frontend URL).
HACKATHON_SERVICE_URL=http://127.0.0.1:4001
JWT_SERVICE_URL=http://127.0.0.1:4004
SCRAPER_SERVICE_URL=http://127.0.0.1:3000
HACKSCOUT_SERVICE_URL=http://127.0.0.1:3002
ETL_SERVICE_URL=http://127.0.0.1:8000
# Optional Supabase scraper URL for durable pipeline controls and gateway-routed cron:
# PIPELINE_SERVICE_URL=https://PROJECT.supabase.co/functions/v1/scraper

# Must match the hackathon, JWT, and mail services. Use a random secret in production.
GATEWAY_INTERNAL_SECRET=local-dev-gateway-secret

# Optional settings: uncomment only when configured. Do not use empty URL values.
# AI_SERVICE_URL=https://your-ai-api.example.com
# PROXY_GRAPHQL_UPSTREAM_URL=https://your-api.example.com/graphql
# ADMIN_API_KEY=replace-with-a-random-admin-key
# LOG_FILE_PATH=logs/gateway.log
# IP_ALLOWLIST=127.0.0.1
# IP_BLOCKLIST=192.0.2.1
# PATH_ALLOWLIST=/api,/gateway
# PATH_BLOCKLIST=/blocked
# Shared by gateway replicas so admin blocklists survive restarts.
# ACCESS_CONTROL_STORE_PATH=/var/lib/gateway/access-control.json
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000
